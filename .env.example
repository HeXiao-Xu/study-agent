# ============================================================
# study-agent 环境变量模板（S0-4 起）
# 复制为 .env 后按需修改；.env 已被 .gitignore 忽略，绝不提交（铁律 8）
# 不建 .env 也能跑：compose 与脚本内置了以下开发默认值
# ============================================================

# ===== 应用（S0-5）=====
APP_NAME=study-agent
ENV=dev
LOG_LEVEL=INFO
# 允许的前端来源，多个用逗号分隔
CORS_ORIGINS=http://localhost:5173

# ===== PostgreSQL（S0-4）=====
POSTGRES_USER=study
POSTGRES_PASSWORD=study123
POSTGRES_DB=study_agent
POSTGRES_PORT=5432
# 后端连接串（S0-5 起使用，账号密码与上面保持一致）
DATABASE_URL=postgresql+psycopg://study:study123@127.0.0.1:5432/study_agent

# ===== Redis（S0-4）=====
REDIS_PORT=6379
REDIS_URL=redis://localhost:6379/0

# ===== MinIO（S0-4；MINIO_ENDPOINT 为应用侧访问地址，S2-6 起使用）=====
MINIO_ENDPOINT=localhost:9000
MINIO_ROOT_USER=study
MINIO_ROOT_PASSWORD=study123456
MINIO_PORT=9000
MINIO_CONSOLE_PORT=9001
MINIO_BUCKET=study-agent

# ===== LLM（S1-6；OpenAI 兼容接口，Key 只放 .env，禁止提交）=====
# 留空时回退 DASHSCOPE_API_KEY
LLM_API_KEY=
LLM_BASE_URL=https://dashscope.aliyuncs.com/compatible-mode/v1
LLM_MODEL=qwen-plus
LLM_TIMEOUT_SECONDS=60
LLM_MAX_RETRIES=2
LLM_TEMPERATURE=0.3
LLM_MAX_OUTPUT_TOKENS=1200
# 元/百万 token；qwen-plus 北京区列表价，仅估算
LLM_PRICE_INPUT_PER_MILLION=0.8
LLM_PRICE_OUTPUT_PER_MILLION=2.0

# ===== 解析（S1-1）=====
# true=PDF 解析跳过 Docling 直接走 PyMuPDF 快速路径（兜底质量：无标题层级）
PARSE_FORCE_PYMUPDF=false

# ===== Embedding（S1-3；Key 只放 .env，禁止提交）=====
EMBEDDING_PROVIDER=dashscope
EMBEDDING_API_KEY=
EMBEDDING_BASE_URL=https://dashscope.aliyuncs.com/compatible-mode/v1
EMBEDDING_MODEL=text-embedding-v4
EMBEDDING_DIM=1024
EMBEDDING_BATCH_SIZE=10
EMBEDDING_TIMEOUT_SECONDS=60
EMBEDDING_MAX_RETRIES=4
EMBEDDING_PRICE_PER_MILLION=0.5

# ===== Rerank（S1-5；Key 只放 .env，禁止提交）=====
RERANK_PROVIDER=dashscope
RERANK_API_KEY=
RERANK_BASE_URL=https://dashscope.aliyuncs.com/api/v1
RERANK_MODEL=qwen3-rerank
RERANK_TIMEOUT_SECONDS=30
RERANK_MAX_RETRIES=2
RERANK_MAX_DOC_TOKENS=3600
RERANK_CANDIDATES=30
RERANK_TOP_K=6
RERANK_PRICE_PER_MILLION=0.5

# ===== QA（S1-6）=====
QA_CONTEXT_MAX_TOKENS=4000
QA_REFUSE_THRESHOLD=0.45
QA_CITATION_MAX_RETRIES=1

# ===== 认证（S2-2；密钥只放 .env，禁止提交）=====
# 生成：python -c "import secrets; print(secrets.token_urlsafe(48))"
AUTH_SECRET_KEY=change-me-generate-a-random-64-char-secret
AUTH_ALGORITHM=HS256
AUTH_ACCESS_TOKEN_EXPIRE_MINUTES=1440
